# ===== 公众号后台「设置与开发 -> 基本配置」=====
# 服务器配置里的 Token（自定义，需与后台填写的一致）
WECHAT_TOKEN=
# AppID（兼容/安全模式必填）
WECHAT_APPID=
# EncodingAESKey（明文模式留空；后台选「兼容模式」或「安全模式」时必填）
WECHAT_ENCODING_AES_KEY=

# 服务端口
PORT=3000
# SQLite 数据库文件路径（相对启动目录，如部署在 /www/wwwroot/wechat 则生成 /www/wwwroot/wechat/bot.db）
DB_PATH=bot.db

# ===== 邮件（注册/找回验证码）=====
# QQ邮箱：smtp.qq.com / 163：smtp.163.com，密码用「授权码」不是登录密码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人显示（默认同 SMTP_USER）
SMTP_FROM=
# true = 验证码直接回复在对话里（仅本地测试用，上线必须删除此行）
# EMAIL_DEBUG=true
